# Alool Design Intelligence — environment variables
# Copy to apps/api/.env or export in your shell before `npm run dev:api`.

# Required for AI Research Agent web search (Tavily)
TAVILY_API_KEY=

# Optional — AI relevance analysis for research candidates (OpenAI-compatible)
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_MODEL=gpt-4o-mini

# API server
# PORT=3001
# HOST=127.0.0.1
