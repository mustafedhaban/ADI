{
  "name": "alool-design-intelligence",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "apps/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspaces --if-present",
    "dev:api": "npm run dev -w @adi/api",
    "dev:web": "npm run dev -w @adi/web",
    "build": "npm run build --workspaces --if-present",
    "db:generate": "npm run db:generate -w @adi/api",
    "db:migrate": "npm run db:migrate -w @adi/api",
    "db:seed": "npm run db:seed -w @adi/api",
    "db:setup": "npm run db:migrate -w @adi/api && npm run db:seed -w @adi/api",
    "test": "npm run test -w @adi/api",
    "test:api": "npm run test -w @adi/api"
  }
}
